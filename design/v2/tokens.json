{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "font": { "family": "Inter, Segoe UI, Arial, sans-serif", "monoFamily": "Cascadia Mono, Consolas, monospace" },
  "color": {
    "background": "#0b1118", "surface": "#121d27", "surfaceRaised": "#182733",
    "border": "#2e4653", "text": "#f4fbfa", "textMuted": "#9bb1b6",
    "accent": "#7af0d0", "energy": "#77d9ff", "harmonic": "#c7a1ff",
    "peak": "#ff8fca", "warning": "#ffd27d", "danger": "#ff9a8e"
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 20, "xl": 28, "xxl": 42 },
  "radius": { "sm": 4, "md": 7, "lg": 10, "pill": 999 },
  "layout": { "railWidth": 220, "contentMaxWidth": 1600, "focusRingWidth": 3 },
  "motion": { "fastMs": 100, "normalMs": 160, "reducedMotion": "disable non-essential animation" }
}
