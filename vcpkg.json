{
  "name": "beatglass",
  "version-string": "0.1.0",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    {
      "name": "aubio",
      "default-features": false
    },
    {
      "name": "libsndfile",
      "default-features": false,
      "features": [
        "external-libs",
        "mpeg"
      ]
    },
    {
      "name": "sqlite3"
    },
    {
      "name": "openssl"
    }
  ],
  "features": {
