{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "vcpkg-core",
      "displayName": "Pinned vcpkg core and CLI",
      "binaryDir": "${sourceDir}/build/vcpkg-core",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "BEATGLASS_BUILD_SLICE": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "prebuilt-qt-desktop",
      "inherits": "vcpkg-core",
      "binaryDir": "${sourceDir}/build/prebuilt-qt-desktop",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{BEATGLASS_QT_ROOT}",
        "Qt6_DIR": "$env{BEATGLASS_QT_ROOT}/lib/cmake/Qt6",
        "BEATGLASS_QT_VERSION": "6.8.3",
        "BEATGLASS_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "vcpkg-desktop",
      "inherits": "vcpkg-core",
      "binaryDir": "${sourceDir}/build/vcpkg-desktop",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "desktop",
        "BEATGLASS_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "vcpkg-tui",
      "inherits": "vcpkg-core",
      "binaryDir": "${sourceDir}/build/vcpkg-tui",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "tui",
        "BEATGLASS_BUILD_TUI": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "vcpkg-core", "configurePreset": "vcpkg-core", "configuration": "Debug" },
    { "name": "prebuilt-qt-desktop", "configurePreset": "prebuilt-qt-desktop", "configuration": "Debug" },
    { "name": "vcpkg-desktop", "configurePreset": "vcpkg-desktop", "configuration": "Debug" }
    ,{ "name": "vcpkg-tui", "configurePreset": "vcpkg-tui", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "vcpkg-core", "configurePreset": "vcpkg-core", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "prebuilt-qt-desktop", "configurePreset": "prebuilt-qt-desktop", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "vcpkg-desktop", "configurePreset": "vcpkg-desktop", "configuration": "Debug", "output": { "outputOnFailure": true } }
    ,{ "name": "vcpkg-tui", "configurePreset": "vcpkg-tui", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
