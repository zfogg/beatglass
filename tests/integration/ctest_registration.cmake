execute_process(COMMAND "${CTEST}" --test-dir "${BUILD}" -C "${CONFIG}" --show-only=json-v1
  RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect CTest registrations: ${error}")
endif()
string(JSON count LENGTH "${json}" tests)
set(found FALSE)
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
  string(JSON name GET "${json}" tests ${i} name)
  if(name STREQUAL "Selected active render endpoint starts and stops loopback when available")
    set(found TRUE)
    string(JSON properties LENGTH "${json}" tests ${i} properties)
    math(EXPR property_last "${properties} - 1")
    foreach(j RANGE 0 ${property_last})
      string(JSON key GET "${json}" tests ${i} properties ${j} name)
      if(key STREQUAL "SKIP_RETURN_CODE")
        string(JSON skip GET "${json}" tests ${i} properties ${j} value)
      elseif(key STREQUAL "TIMEOUT")
        string(JSON timeout GET "${json}" tests ${i} properties ${j} value)
      endif()
    endforeach()
  endif()
endforeach()
if(NOT found OR NOT skip EQUAL 4 OR NOT timeout EQUAL 30)
  message(FATAL_ERROR "Hardware test registration lost skip/timeout: found=${found}, skip=${skip}, timeout=${timeout}")
endif()
